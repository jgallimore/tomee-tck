<!-- The contents of this file will be loaded for each web application -->
<Context crossContext="true" resourceOnlyServlets="jsp" jndiExceptionOnFailedWrite="false">
    <!-- LegacyCookieProcessor no longer exists in Tomcat 10.1.x; use the RFC 6265 processor (the Tomcat default) -->
    <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" />
    <!-- Default set of monitored resources. If one of these changes, the    -->
    <!-- web application will be reloaded.                                   -->
    <WatchedResource>WEB-INF/web.xml</WatchedResource>
    <WatchedResource>WEB-INF/tomcat-web.xml</WatchedResource>
    <WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>

    <!-- Uncomment this to disable session persistence across Tomcat restarts -->
    <!--
    <Manager pathname="" />
    -->

    <!-- Tomcat's default manager. Session ids use SHA1PRNG (Tomcat's default), or the platform
         default with -o fips, which is an approved DRBG in FIPS mode (SetupCommand) -->
    <Manager>
        <SessionIdGenerator secureRandomAlgorithm="%session.secureRandomAlgorithm%" />
    </Manager>

    <Valve className="org.apache.openejb.cts.TransactionalWorkaroundLeakGuardValve"/>

    <Environment name="myUrl" value="http://google.com"
                 type="java.net.URL" override="false"/>

</Context>
