# java.security for -o bcfips, which replaces the JDK's (-Djava.security.properties==), as in "Bouncy Castle FIPS"
# in TomEE's docs/fips-140-3.adoc. Bouncy Castle FIPS provides all cryptography and TLS; SUN stays as entropy
# for the BCFIPS DRBG and for non cryptographic services (JAAS configuration, policy), and still serves non
# approved algorithms requested by name (MD5, SHA1PRNG...).
security.provider.1=org.bouncycastle.jcajce.provider.BouncyCastleFipsProvider
security.provider.2=org.bouncycastle.jsse.provider.BouncyCastleJsseProvider fips:BCFIPS
security.provider.3=SUN

# Not BCFIPS: its DRBG seeds itself from SecureRandom.getInstanceStrong(), which would recurse
securerandom.source=file:/dev/random
securerandom.strongAlgorithms=NativePRNGBlocking:SUN
keystore.type=BCFKS
ssl.KeyManagerFactory.algorithm=PKIX
ssl.TrustManagerFactory.algorithm=PKIX
login.configuration.provider=sun.security.provider.ConfigFile
policy.provider=sun.security.provider.PolicyFile
policy.url.1=file:${java.home}/conf/security/java.policy
crypto.policy=unlimited
